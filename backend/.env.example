# Non-secret prototype defaults. Copy to .env to override.
APP_NAME=LexAssist API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Local PostgreSQL connection. Replace CHANGE_ME with the real password in .env (never commit it).
DATABASE_URL=postgresql+psycopg://lexassist:CHANGE_ME@localhost:5433/lexassist
# Authentication settings
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# AI Provider settings (Step 17)
AI_ENABLED=false
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash
